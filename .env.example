# ========================================================
# Smart Living & Safety Platform - Environment Variables
# Copy this file to .env and adjust values for your environment.
# ========================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/smart_living_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JPA / Hibernate Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Security & JWT Configuration (Phase 2 Placeholder)
JWT_SECRET=smart_living_secret_key_placeholder_change_in_production_min_256_bits
JWT_EXPIRATION_MS=86400000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Vite Client Configuration
VITE_API_URL=http://localhost:8080
